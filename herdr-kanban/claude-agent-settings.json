{
  "env": {
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "autoMemoryEnabled": false,
  "remoteControlAtStartup": false,
  "promptSuggestionEnabled": false,
  "enabledPlugins": {
    "vercel-plugin@vercel": false,
    "i-have-adhd@i-have-adhd": false,
    "agents-design-experience@buildwithclaude": false,
    "andrej-karpathy-skills@karpathy-skills": false,
    "agent-coms@pouroa-plugins": false,
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/bin/npm-guard.mjs --env", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "PowerShell", "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/bin/npm-guard.mjs --hook", "timeout": 10 }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/scripts/check-script-guard.mjs --pre", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/scripts/check-script-guard.mjs --post", "timeout": 10 }] },
      { "matcher": "Bash|PowerShell", "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/scripts/agent-handoff-hook.mjs", "timeout": 10 }] },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/scripts/run-cap-hook.mjs", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node C:/Users/PFrew/Projects/herdr-kanban/scripts/agent-stop-hook.mjs", "timeout": 30 }] }
    ]
  }
}
